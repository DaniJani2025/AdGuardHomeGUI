<Application x:Class="AdGuardHomeGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdGuardHomeGUI"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">
    <Application.Resources>
        
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Open" Click="OpenTray_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="ExitTray_Click"/>
        </ContextMenu>

        <tb:TaskbarIcon
            x:Key="TrayIcon"
            IconSource="/Assets/AdGuard.ico"
            ToolTipText="AdGuard Home GUI"
            ContextMenu="{StaticResource TrayMenu}"
            TrayLeftMouseUp="TrayIcon_TrayLeftMouseUp"/>
        
    </Application.Resources>
</Application>
