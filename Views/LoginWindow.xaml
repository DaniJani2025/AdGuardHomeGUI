<Window x:Class="AdGuardHomeGUI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdGuard Home Login"
        Width="420"
        Height="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/AdGuard.ico">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="AdGuard Home"
            FontSize="22"
            FontWeight="SemiBold"
            HorizontalAlignment="Center"/>

        <TextBlock
            Grid.Row="1"
            Margin="0,20,0,4"
            Text="Username"/>

        <TextBox
            x:Name="UsernameTextBox"
            Grid.Row="2"
            Height="32"/>

        <TextBlock
            Grid.Row="3"
            Margin="0,16,0,4"
            Text="Password"/>

        <PasswordBox
            x:Name="PasswordBox"
            Grid.Row="4"
            Height="32"/>

        <CheckBox
            x:Name="RememberMeCheckBox"
            Grid.Row="5"
            Margin="0,20,0,0"
            VerticalAlignment="Top"
            Content="Remember me"/>

        <StackPanel
            Grid.Row="6">

            <TextBlock
                x:Name="StatusTextBlock"
                Margin="0,0,0,12"
                Text="Enter your AdGuard Home credentials."
                HorizontalAlignment="Center"/>

            <Button
                x:Name="LoginButton"
                Width="120"
                Height="38"
                HorizontalAlignment="Center"
                Content="Login"
                Click="Login_Click"/>

        </StackPanel>

    </Grid>

</Window>